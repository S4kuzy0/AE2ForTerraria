// 文件名里的 "Mods.AE2ForTerraria" 就是键前缀,
// 所以下面的键从「Items」这一层开始写,不要再套一层 Mods / AE2ForTerraria ——
// 套了的话真实键会变成 Mods.AE2ForTerraria.Mods.AE2ForTerraria.Items.*,
// tModLoader 找不到,于是自动生成 "M E Storage Unit" 这种乱名字。

Items: {
	MEDigitalSingularity: {
		DisplayName: 数字奇点
		Tooltip:
			'''
			为驱动器增加物品总数和类别容量
			两项上限均为 9,223,372,036,854,775,807
			物品保存在驱动器中
			'''
	}

	MEWirelessBridge: {
		DisplayName: ME 无线桥接器
		Tooltip: 同一频道且启用的桥接器会连接网络。右键查看频道、换频道或断开。
	}

	MECable: {
		DisplayName: ME 网络线缆
		Tooltip: 便宜地把 ME 网络连过去,本身不提供容量。
	}

	MEStorageBus: {
		DisplayName: ME 存储总线
		Tooltip:
			'''
			贴着原版箱子放置,就能把那个箱子并进 ME 网络。
			空手右键打开配置:导入 / 导出切换 + 分区清单(白/黑名单,可搜索勾选)。
			手持物品右键 = 把这个物品加进 / 移出分区清单。
			'''
	}

	MEStorageUnit: {
		DisplayName: ME 存储单元
		Tooltip: 不需要磁盘的固定容量存储方块。手持 ME 存储升级件右键可以升级。
	}

	MEAccessTerminal: {
		DisplayName: ME 访问终端
		Tooltip:
			'''
			右键打开已储存物品，并绑定当前 ME 网络。
			之后按「远程打开访问终端」键(默认 P)可远程存取该网络的物品。
			'''
	}

	MECraftingCpu: {
		DisplayName: ME 合成 CPU
		Tooltip:
			'''
			兼容原有合成队列；新合成终端已经内置队列功能。
			手持物品右键加入队列(按住下键一次加 10),空手右键打开队列界面。
			'''
	}

	MEDiskDrive: {
		DisplayName: ME 磁盘驱动器
		Tooltip:
			'''
			把不同级别的存储磁盘插进去提供容量。
			物品保存在驱动器中，磁盘只提供容量。剩余容量不足时禁止移出或降级磁盘。
			'''
	}

	MECraftingTerminal: {
		DisplayName: ME 合成终端
		Tooltip:
			'''
			右键查看合成配方、任务与工作站；点选物品可查看合成树与缺料。
			「可合成」只显示当前材料和原配方条件均满足的物品。
			内置自动合成队列与工作站槽，无需独立 CPU 或装配室。
			仍需材料、工作站和原配方的环境条件。
			'''
	}

	MEMolecularAssembler: {
		DisplayName: ME 分子装配室
		Tooltip:
			'''
			兼容原有装配任务与工作站；连接合成终端后由终端统一调度。
			需要把工作站(工作台 / 铁砧 / 熔炉)放进它的槽位,否则对应配方无法合成。
			不需要写样板:只要配方条件满足且原料齐全就会自动制造。
			新网络只需合成终端即可自动合成。
			'''
	}

	MEDropCollector: {
		DisplayName: ME 掉落收集器
		Tooltip:
			'''
			把附近的掉落物直接吸入网络。
			被过滤掉的掉落物会留在原地。
			右键打开它自己的过滤清单(每块收集器各有一份)。
			'''
	}

	MEDisk1K: {
		DisplayName: ME 存储磁盘（32 类）
		Tooltip:
			'''
			为驱动器增加 32 个类别位
			每类最多 2,147,483,647 个物品
			不同词缀、自定义数据分别占类
			物品保存在驱动器中
			'''
	}

	MEDisk4K: {
		DisplayName: ME 存储磁盘（64 类）
		Tooltip:
			'''
			为驱动器增加 64 个类别位
			每类最多 2,147,483,647 个物品
			不同词缀、自定义数据分别占类
			物品保存在驱动器中
			'''
	}

	MEDisk16K: {
		DisplayName: ME 存储磁盘（128 类）
		Tooltip:
			'''
			为驱动器增加 128 个类别位
			每类最多 2,147,483,647 个物品
			不同词缀、自定义数据分别占类
			物品保存在驱动器中
			'''
	}

	MEDisk64K: {
		DisplayName: ME 存储磁盘（256 类）
		Tooltip:
			'''
			为驱动器增加 256 个类别位
			每类最多 2,147,483,647 个物品
			不同词缀、自定义数据分别占类
			物品保存在驱动器中
			'''
	}

	MEStorageUpgrade: {
		DisplayName: ME 存储升级件
		Tooltip:
			'''
			手持它右键 ME 存储单元即可升一级:
			Lv.1 8K 字节 -> Lv.2 32K -> Lv.3 128K。
			'''
	}
}

Keybinds: {
	OpenSearch.DisplayName: 打开物品浏览器
	OpenRemoteTerminal.DisplayName: 远程打开访问终端
	OpenNetworkOverview.DisplayName: 打开 ME 网络概览
	ToggleMagnet.DisplayName: 切换随身掉落磁铁
}

Tiles: {
	MEWirelessBridgeTile.MapEntry: ME 无线桥接器
	MECableTile.MapEntry: ME 网络线缆
	MEStorageBusTile.MapEntry: ME 存储总线
	MEStorageUnitTile.MapEntry: ME 存储单元
	MEAccessTerminalTile.MapEntry: ME 访问终端
	MECraftingCpuTile.MapEntry: ME 合成 CPU
	MEDiskDriveTile.MapEntry: ME 磁盘驱动器
	MECraftingTerminalTile.MapEntry: ME 合成终端
	MEMolecularAssemblerTile.MapEntry: ME 分子装配室
	MEDropCollectorTile.MapEntry: ME 掉落收集器
}

Achievements: {
	StoreFirstItemAchievement: {
		FriendlyName: 第一次入库
		Description: 把物品存进 ME 网络 —— 终端「存入全部」、存储单元右键、掉落收集器、存储总线导入、随身磁铁任意一种都算
	}

	AutomateFirstItemAchievement: {
		FriendlyName: 全自动
		Description: 让分子装配室自动造出一件物品(工作站放齐、设好目标或往 CPU 下单即可)
	}

	BindTerminalAchievement: {
		FriendlyName: 随身网络
		Description: 右键 ME 访问终端绑定网络,之后按键(默认 P)可以远程打开
	}

	KeepStockAchievement: {
		FriendlyName: 永不断供
		Description: 在合成终端选中物品 + 填数量,点「维持库存」;网络里少于这个数就会自动补货
	}

	BigStorageAchievement: {
		FriendlyName: 大容量
		Description: 让一个网络的已用容量达到 64K 字节(插更高级的磁盘,再往里存东西)
	}

	LongRangeWirelessAchievement: {
		FriendlyName: 跨世界连线
		Description: 用无线桥接器把相隔 500 格以上的两个网络连起来(两端设成同一个频道)
	}

	KeepFiveAchievement: {
		FriendlyName: 仓库管理员
		Description: 同时维持 5 种物品的库存
	}

	FiveAssemblersAchievement: {
		FriendlyName: 并行生产
		Description: 让同一个 ME 网络里同时有 5 个分子装配室(多一份并行合成进度)
	}

	TransferNetworkAchievement: {
		FriendlyName: 网络搬家
		Description: 把一整个网络的东西转移到另一个网络(网络概览里「作为来源」→ 选中目标 →「接收转移」)
	}
}

Configs: {
	MEConfig: {
		DisplayName: ME 网络

		PersonalMagnetEnabled: {
			Label: 随身掉落磁铁
			Tooltip: 站在自己的 ME 网络旁边时,附近的掉落物直接进网。默认关闭。
		}

		PersonalMagnetRadius: {
			Label: 随身磁铁半径(格)
			Tooltip: 随身磁铁的覆盖范围。
		}

		PersonalMagnetFilteredItems: {
			Label: 随身磁铁过滤清单
			Tooltip: 只作用于随身磁铁(和掉落收集器的默认清单分开)。
		}

		PersonalMagnetIsBlacklist: {
			Label: 磁铁清单用作黑名单
			Tooltip: 开 = 清单里的不吸;关 = 只吸清单里的。清单为空时不过滤。
		}

		VoidOverflowDrops: {
			Label: 满了就销毁掉落物
			Tooltip: 开着时,掉落收集器 / 随身磁铁遇到「网络满了吸不进去」的掉落物会直接销毁,而不是留在原地。默认关闭。
		}

		VerboseLogging: {
			Label: 详细日志
			Tooltip: 把索引统计、图鉴诊断、商店扫描样本、拼音表大小写进日志。默认关闭。
		}

		CheatModeEnabled: {
			Label: 启用作弊模式
			Tooltip: 开启后物品浏览器右下角出现扳手,点亮它再 Shift+左键可直接刷出物品。默认开启(关掉后扳手按钮不出现)。
		}

		DropCollectorEnabled: {
			Label: 启用掉落收集器
			Tooltip: 新放置的掉落收集器默认是否工作。放好之后每块可以单独开关。
		}

		DropCollectorRadius: {
			Label: 收集半径(格)
			Tooltip: 新收集器默认半径；大于 256 格为无限，覆盖整个世界的掉落物。
		}

		FilterIsBlacklist: {
			Label: 清单用作黑名单
			Tooltip: 开 = 清单里的不收;关 = 只收清单里的。作用于新放置的收集器。
		}

		FilteredItems: {
			Label: 过滤清单
			Tooltip: 新放置的收集器的默认过滤清单。
		}

		CraftTicksPerItem: {
			Label: 旧装配室合成耗时(tick)
			Tooltip: 仅用于未连接合成终端的旧装配室。合成终端已取消固定耗时，不受此设置影响。
		}

		CustomBossOrder: {
			Label: 自定义 Boss 顺序
			Tooltip: 每行一个阶段名,从上到下就是先后顺序。留空则使用内置表 / BossChecklist 的顺序。
		}

		DepositIncludesAmmoAndCoins: {
			Label: 存入全部包含弹药 / 钱币
			Tooltip: 开 = 「存入全部」连弹药栏和钱币栏一起存;关 = 只存主背包(默认)。
		}
	}
}

