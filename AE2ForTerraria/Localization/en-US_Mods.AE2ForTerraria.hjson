// 文件名里的 "Mods.AE2ForTerraria" 就是键前缀,
// 所以下面的键从「Items」这一层开始写,不要再套一层 Mods / AE2ForTerraria ——
// 套了的话真实键会变成 Mods.AE2ForTerraria.Mods.AE2ForTerraria.Items.*,
// tModLoader 找不到,于是自动生成 "M E Storage Unit" 这种乱名字。

Items: {
	MEDigitalSingularity: {
		DisplayName: Digital Singularity
		Tooltip:
			'''
			Adds total quantity and type capacity to a drive
			Both limits: 9,223,372,036,854,775,807
			Items remain stored in the drive
			'''
	}

	MEWirelessBridge: {
		DisplayName: ME Wireless Bridge
		Tooltip: Enabled bridges on the same channel link networks. Right-click to inspect, change channel or disconnect.
	}

	MECable: {
		DisplayName: ME Network Cable
		Tooltip: Cheaply extends the ME network. Provides no capacity itself.
	}

	MEStorageBus: {
		DisplayName: ME Storage Bus
		Tooltip:
			'''
			Place it next to a vanilla chest to bridge that chest into the ME network.
			Right-click empty-handed to configure: import/export mode plus a partition list
			(whitelist/blacklist with a searchable grid).
			Right-click holding an item toggles that item in the partition list.
			'''
	}

	MEStorageUnit: {
		DisplayName: ME Storage Unit
		Tooltip: Fixed-capacity storage block that needs no disks. Right-click holding an ME Storage Upgrade to raise its level.
	}

	MEAccessTerminal: {
		DisplayName: ME Access Terminal
		Tooltip:
			'''
			Right-click to open stored items and bind the current ME network.
			Press the remote access terminal key (default P) to access its storage from anywhere.
			'''
	}

	MECraftingCpu: {
		DisplayName: ME Crafting CPU
		Tooltip:
			'''
			Legacy queue host. Crafting terminals now include their own queue and station inventory.
			Right-click with an item to queue it (hold Down to queue 10), right-click empty-handed to open the queue.
			'''
	}

	MEDiskDrive: {
		DisplayName: ME Disk Drive
		Tooltip:
			'''
			Insert storage disks to provide capacity.
			Items are stored in the drive itself; disks only give capacity,
			a disk cannot be removed if the remaining capacity cannot hold the contents.
			'''
	}

	MECraftingTerminal: {
		DisplayName: ME Crafting Terminal
		Tooltip:
			'''
			Right-click to browse crafting recipes, tasks and stations.
			Select an item to see its crafting tree and missing ingredients.
			Craftable shows only items whose materials and original recipe conditions are satisfied.
			Includes crafting tasks and station slots; no separate CPU or assembler is required.
			'''
	}

	MEMolecularAssembler: {
		DisplayName: ME Molecular Assembler
		Tooltip:
			'''
			Molecular assembler and crafting CPU combined into one block.
			Put crafting stations (work bench, anvil, furnace...) into its slots,
			otherwise recipes requiring them cannot be crafted.
			No patterns needed: any recipe with met conditions and ingredients is craftable.
			Crafting is timed per item; more assemblers on the network craft in parallel.
			'''
	}

	MEDropCollector: {
		DisplayName: ME Drop Collector
		Tooltip:
			'''
			Vacuums nearby drops straight into the network.
			Filtered drops are left on the ground.
			Right-click to open its own filter (each collector keeps its own list).
			'''
	}

	MEDisk1K: {
		DisplayName: ME Storage Disk (32 Types)
		Tooltip:
			'''
			Adds 32 item identity slots to a drive
			Up to 2,147,483,647 items per identity
			Prefixes and custom data use separate slots
			Items remain stored in the drive
			'''
	}

	MEDisk4K: {
		DisplayName: ME Storage Disk (64 Types)
		Tooltip:
			'''
			Adds 64 item identity slots to a drive
			Up to 2,147,483,647 items per identity
			Prefixes and custom data use separate slots
			Items remain stored in the drive
			'''
	}

	MEDisk16K: {
		DisplayName: ME Storage Disk (128 Types)
		Tooltip:
			'''
			Adds 128 item identity slots to a drive
			Up to 2,147,483,647 items per identity
			Prefixes and custom data use separate slots
			Items remain stored in the drive
			'''
	}

	MEDisk64K: {
		DisplayName: ME Storage Disk (256 Types)
		Tooltip:
			'''
			Adds 256 item identity slots to a drive
			Up to 2,147,483,647 items per identity
			Prefixes and custom data use separate slots
			Items remain stored in the drive
			'''
	}

	MEStorageUpgrade: {
		DisplayName: ME Storage Upgrade
		Tooltip:
			'''
			Right-click an ME Storage Unit while holding this to upgrade it one level
			(Lv.1 8K bytes -> Lv.2 32K -> Lv.3 128K).
			'''
	}
}

Keybinds: {
	OpenSearch.DisplayName: Open Item Browser
	OpenRemoteTerminal.DisplayName: Open Remote Access Terminal
	OpenNetworkOverview.DisplayName: Open ME Network Overview
	ToggleMagnet.DisplayName: Toggle Personal Drop Magnet
}

