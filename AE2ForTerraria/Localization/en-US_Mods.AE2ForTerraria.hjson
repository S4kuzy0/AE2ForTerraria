	MEStorageUnitTile.MapEntry: ME Storage Unit
	MEAccessTerminalTile.MapEntry: ME Access Terminal
	MECraftingCpuTile.MapEntry: ME Crafting CPU
	MEDiskDriveTile.MapEntry: ME Disk Drive
	MECraftingTerminalTile.MapEntry: ME Crafting Terminal
	MEMolecularAssemblerTile.MapEntry: ME Molecular Assembler
	MEDropCollectorTile.MapEntry: ME Drop Collector
}

Achievements: {
	StoreFirstItemAchievement: {
		FriendlyName: First Deposit
		Description: Store an item into an ME network -- any of these count: terminal "Store All", right-clicking a storage unit, a drop collector, a storage bus import, or the personal magnet
	}

	AutomateFirstItemAchievement: {
		FriendlyName: Fully Automated
		Description: Let a molecular assembler craft an item on its own (stations installed, then set a target or order from a CPU)
	}

	BindTerminalAchievement: {
		FriendlyName: Network In Your Pocket
		Description: Right-click an ME access terminal to bind the network, then press the remote key (default P) to open it anywhere
	}

	KeepStockAchievement: {
		FriendlyName: Never Run Dry
		Description: In the terminal, pick an item, set an amount and press "Keep stocked"; the network auto-refills when it drops below that
	}

	BigStorageAchievement: {
		FriendlyName: Big Storage
		Description: Push a single network past 64K bytes of used capacity (insert better disks and keep filling it)
	}

	LongRangeWirelessAchievement: {
		FriendlyName: Across the World
		Description: Link two networks more than 500 tiles apart with wireless bridges (set both to the same channel)
	}

	KeepFiveAchievement: {
		FriendlyName: Quartermaster
		Description: Keep 5 different items stocked at the same time
	}

	FiveAssemblersAchievement: {
		FriendlyName: Parallel Production
		Description: Have 5 molecular assemblers in the same ME network (one more parallel crafting track)
	}

	TransferNetworkAchievement: {
		FriendlyName: Network Moving Day
		Description: Move everything from one network into another - pick As Source on it, then pick the target and press Receive Transfer
	}
}

Configs: {
	MEConfig: {
		DisplayName: ME Network

		PersonalMagnetEnabled: {
			Label: Personal Drop Magnet
			Tooltip: While standing next to your ME network, nearby drops go straight into it. Off by default.
		}

		PersonalMagnetRadius: {
			Label: Personal Magnet Radius (tiles)
			Tooltip: How far the personal magnet reaches.
		}

		PersonalMagnetFilteredItems: {
			Label: Personal Magnet Filter
			Tooltip: Only applies to the personal magnet (separate from the drop collector's default list).
		}

		PersonalMagnetIsBlacklist: {
			Label: Use Magnet List As Blacklist
			Tooltip: On = never vacuum the listed items. Off = only vacuum the listed items. An empty list means no filter.
		}

		VoidOverflowDrops: {
			Label: Void Drops When Full
			Tooltip: When the network is full, drop collectors / the personal magnet destroy the drops they cannot store instead of leaving them on the ground. Off by default.
		}

		VerboseLogging: {
			Label: Verbose Logging
			Tooltip: Writes index statistics, bestiary diagnostics, shop scan samples and the pinyin table size to the log. Off by default.
		}

		CheatModeEnabled: {
			Label: Enable Cheat Mode
			Tooltip: Shows the wrench in the item browser; light it up and Shift+Left-click spawns items. On by default (the button disappears when this is off).
		}

		DropCollectorEnabled: {
			Label: Enable Drop Collector
			Tooltip: Whether newly placed drop collector blocks vacuum items into the network. Each block can be toggled on its own afterwards.
		}

		DropCollectorRadius: {
			Label: Collection Radius (tiles)
			Tooltip: Default reach for newly placed drop collectors.
		}

		FilterIsBlacklist: {
			Label: Use List As Blacklist
			Tooltip: On = never collect the listed items. Off = only collect the listed items. Applies to newly placed collectors.
		}

		FilteredItems: {
			Label: Filtered Items
			Tooltip: Default filter list for newly placed collectors.
		}

		CraftTicksPerItem: {
			Label: Legacy Assembler Crafting Ticks
			Tooltip: Applies only to legacy assemblers without a crafting terminal. Integrated terminal crafting has no fixed delay and ignores this setting.
		}

		CustomBossOrder: {
			Label: Custom Boss Order
			Tooltip: One stage name per line, top to bottom. Leave empty to use the built-in / BossChecklist order.
		}

		DepositIncludesAmmoAndCoins: {
			Label: Deposit All includes ammo and coins
			Tooltip: On = Deposit All also stores your ammo and coin slots. Off = main inventory only (default).
		}
	}
}

