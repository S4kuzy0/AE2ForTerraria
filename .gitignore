# Only maintainable project inputs belong in this repository.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/AE2ForTerraria/
!/docs/
!/tools/
!/validation/
!/ui-preview/

# Private files and generated outputs, at any depth.
**/bin/
**/obj/
**/node_modules/
**/__pycache__/
**/.vs/
**/.idea/
**/.vscode/
**/.local/
**/backups/
**/dist/
**/Worlds/
**/Players/
**/ModConfigs/
**/SaveData/
*.tmod
*.dll
*.pdb
*.exe
*.zip
*.7z
*.log
*.pid
*.wld*
*.twld*
*.plr*
*.tplr*
*.map
*.tmap
*.bak*
*.tmp
*.user
*.suo
.env
.env.*
*.pem
*.key
config.json
client-config.json
client-preferences.json
enabled.json
AE2ForTerraria-Layout.txt

# Preview assets extracted from the installed game remain local.
/ui-preview/*
!/ui-preview/recipe-browser/
/ui-preview/recipe-browser/*
!/ui-preview/recipe-browser/FEATURE-PARITY.md

# Keep reusable harness inputs, rather than historical runs and test saves.
/validation/*
!/validation/stage2/
/validation/stage2/*
!/validation/stage2/PlannerRegression.cs
!/validation/stage2/PlannerHarness/
!/validation/stage2/BusHarness/
!/validation/stage2/CraftCommitHarness/
/validation/stage2/PlannerHarness/*
!/validation/stage2/PlannerHarness/PlannerHarness.csproj
!/validation/stage2/PlannerHarness/Program.cs
!/validation/stage2/PlannerHarness/Stubs.cs
/validation/stage2/BusHarness/*
!/validation/stage2/BusHarness/BusHarness.csproj
!/validation/stage2/BusHarness/Program.cs
!/validation/stage2/BusHarness/Stubs.cs
!/validation/stage2/BusHarness/Prepare.ps1
/validation/stage2/CraftCommitHarness/*
!/validation/stage2/CraftCommitHarness/CraftCommitHarness.csproj
!/validation/stage2/CraftCommitHarness/Program.cs
!/validation/stage2/CraftCommitHarness/Stubs.cs
!/validation/stage2/CraftCommitHarness/Header.txt
!/validation/stage2/CraftCommitHarness/prepare.py

# These harness files are generated from the current source before a run.
SourceBus.cs
SourceAssembler.cs
